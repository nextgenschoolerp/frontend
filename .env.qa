VITE_DEPLOYMENT_ENV=qa
VITE_SESSION_IDLE_TIMEOUT_MINUTES=15
# Leave empty when QA serves the API through the same-origin ingress.
# Set a QA API gateway origin at build time if the API is hosted separately.
VITE_API_BASE_URL=

# Help & support contact card (email / phone lines are hidden while empty)
VITE_SUPPORT_EMAIL=helpdesk@yourschool.in
VITE_SUPPORT_PHONE=+91 11 4000 1234
VITE_SUPPORT_HOURS=Mon–Sat · 08:00–17:00 IST
